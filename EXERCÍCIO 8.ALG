Algoritmo "semnome"
// Feito por katarina
Var

num1, num2, num3, soma: inteiro

Inicio
.
escreva("Digite o primeiro número: ")
leia(num1)

escreva("Digite o segundo número: ")
leia(num2)

escreva("Digite o terceiro número: ")
leia(num3)

soma <- num1 + num2 + num3

escreval("O resultado da soma de números inteiros é: ",soma)

Fimalgoritmo
