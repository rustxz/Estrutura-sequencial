Algoritmo "semnome"
//feito por katarina
Var
// Seção de Declarações das variáveis 
num, dobro, triplo: inteiro

Inicio
// Seção de Comandos, procedimento, funções, operadores, etc... 
escreva("Digite um número inteiro: ")
leia(num)

dobro <- num * 2

triplo <- num * 3

escreval("O dobro desse número é: ",dobro)

escreval("O triplo desse número é: ",triplo)

Fimalgoritmo
