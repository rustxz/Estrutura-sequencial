algoritmo "Exercicio 6"
// Feito por: Gustavo Abreu



var
num1, num2, resultado : real


inicio
Escreval("Digite o primeiro número: ")
leia(num1)

Escreval("Digite o segundo número: ")
leia(num2)

resultado <- num1 + num2

Escreval("Seu resultado é: ", resultado)




fimalgoritmo