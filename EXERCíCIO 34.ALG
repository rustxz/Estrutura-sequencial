Algoritmo "Exercício 34"
// Feito por: Gustavo Abreu


Var
celsius, fahrenheit : real


Inicio

Escreval("Digite sua temperatura em Celsius: ")
leia(celsius)

fahrenheit <- (celsius * 9/5) + 32

escreval("")
escreval("Sua temperatura em Fahrenheit é de: ",fahrenheit, "°F")



Fimalgoritmo