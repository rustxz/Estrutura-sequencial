algoritmo "Exercicio 22"
// Feito por: Gustavo Abreu



var

perimetro, largura, altura :real



inicio

escreval("Digite a largura do retangulo: ")
leia(largura)

escreval("Digite a altura do retangulo: ")
leia(altura)

perimetro <- 2 * (altura + largura)

escreval("O perimetro do seu retângulo é: ", perimetro)


fimalgoritmo