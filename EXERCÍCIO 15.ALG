Algoritmo "semnome"
// Feito por katarina
Var
// Seção de Declarações das variáveis 
horas, minutos: real

Inicio
// Seção de Comandos, procedimento, funções, operadores, etc... 
escreva("Digite suas horas: ")
leia(horas)

minutos <- horas * 60

escreval("A quantidade de minutos é: ", minutos)

Fimalgoritmo
