algoritmo "exercício 5"
// feito por Rafael Araujo
var

  n :inteiro

inicio
  escreval ("---------------------------")
  escreval ("   Antecessor e sucessor   ")
  escreval ("---------------------------")
  escreval ("Digite um numero: ")
  leia (n)
  escreval ("antecessor: ",n - 1)
  escreval ("numero: ",n)
  escreval ("Sucessor: " n + 1)
fimalgoritmo
