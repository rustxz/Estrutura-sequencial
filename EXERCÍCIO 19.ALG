Algoritmo "semnome"
// Feito por katarina
Var
// Seção de Declarações das variáveis 
pesokg, pesogramas: real

Inicio
// Seção de Comandos, procedimento, funções, operadores, etc... 
escreva("Digite o peso em kg: ")
leia(pesokg)

pesogramas <- pesokg * 1000

escreval("O peso em gramas é: ",pesogramas)

Fimalgoritmo
